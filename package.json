{
  "name": "the-house-always-watches",
  "version": "0.2.2",
  "private": true,
  "description": "THE HOUSE ALWAYS WATCHES — roguelike de cartas + casino maldito + terror pixel art (vertical slice jugable en el navegador).",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "build": "node tools/build-locales.mjs && node tools/build-single.mjs",
    "i18n": "node tools/build-locales.mjs && node tools/check-i18n.mjs",
    "check": "node tools/check-i18n.mjs && node tools/test-logic.mjs && node tools/test-jokers.mjs && node tools/test-extras.mjs && node tools/test-help.mjs && node tools/test-game.mjs 6 1",
    "test:wings": "node tools/test-game.mjs 24 2 --wing=all",
    "test:ui": "python3 tools/ui-bot.py --fast --steps 300 --budget 120",
    "test:extras": "python3 tools/test-ui-extras.py",
    "test:more": "python3 tools/test-ui-more.py",
    "test:contrast": "python3 tools/test-contrast.py",
    "test:features": "python3 tools/test-features.py",
    "test:single": "python3 tools/test-single.py",
    "balance": "node tools/sim-balance.mjs",
    "test:logic-extras": "node tools/test-extras.mjs",
    "test:i18n": "python3 tools/test-i18n.py --langs en,es,fr,de,eu",
    "test:i18n-load": "python3 tools/test-i18n-load.py",
    "test:round3": "python3 tools/test-ui-round3.py"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
